# Templates only. Keep real settings in a local ignored file or secret manager.
# Local npm run dev uses SQLite and loopback-only developer identity.
# Deployment: generate a unique password and URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-generated-private-password
DATABASE_URL=postgresql+psycopg://printapp:replace-with-url-encoded-private-password@db:5432/print_workflow
PRINT_DEV=0
PRINT_ORIGIN=https://replace-with-approved-hostname
PRINT_ALLOWED_HOSTS=replace-with-approved-hostname,127.0.0.1,localhost
